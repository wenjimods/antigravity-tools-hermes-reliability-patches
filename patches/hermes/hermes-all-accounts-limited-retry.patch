+def parse_upstream_wait_seconds(error_or_text: Any) -> Optional[float]:
+    text = _error_text(error_or_text)
+    import re
+    m = re.search(r"all accounts limited[.\s,]*wait\s+(\d+)\s*s", text, re.I)
+    return min(max(float(m.group(1)) + 0.0, 0.0), 600.0) if m else None
+
