# Hermes Environment Configuration Template for Local AGT Bridge
# Copy to ~/.hermes/.env or source in your shell profile

# Point OpenAI-compatible client to AGT local port 8045
OPENAI_API_BASE=http://127.0.0.1:8045/v1

# Read your proxy api key from AGT GUI or config. Never hardcode here.
OPENAI_API_KEY=your_agt_proxy_api_key_here

# Default model configuration
HERMES_MODEL=gemini-2.5-pro

# Optional logging verbosity
HERMES_LOG_LEVEL=INFO
